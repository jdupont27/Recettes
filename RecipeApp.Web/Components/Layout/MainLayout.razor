@inherits LayoutComponentBase
@using RecipeApp.Domain.Enums
@using RecipeApp.Infrastructure.Identity
@inject AuthenticationStateProvider AuthState

<div class="@ClasseTheme">
    <div class="d-print-none">
        <NavMenu />
    </div>

    <div class="container mt-4">
        @Body
    </div>

    <footer class="py-3 bg-light border-top mt-5 d-print-none">
        <div class="container text-center text-muted">
            <small>RecetteApp &copy; @DateTime.Now.Year</small>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Une erreur inattendue est survenue.
    <a href="." class="reload">Recharger</a>
    <span class="dismiss">&#10006;</span>
</div>

@code {
    private string ClasseTheme { get; set; } = ClasseDuTheme(ThemeVisuel.Classique);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var claim = authState.User.FindFirst(ThemeClaimsPrincipalFactory.TypeClaim);
        if (claim != null && Enum.TryParse<ThemeVisuel>(claim.Value, out var theme))
            ClasseTheme = ClasseDuTheme(theme);
    }

    private static string ClasseDuTheme(ThemeVisuel theme) => theme switch
    {
        ThemeVisuel.ChaleureuxArtisanal => "theme-artisanal",
        ThemeVisuel.EpureMinimaliste => "theme-minimaliste",
        ThemeVisuel.EditorialMagazine => "theme-editorial",
        _ => ""
    };
}
