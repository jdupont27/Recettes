@page "/compte/reinitialiser-mot-de-passe"
@using Microsoft.AspNetCore.Identity
@using RecipeApp.Infrastructure.Identity
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Réinitialiser le mot de passe</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="card-title text-center mb-4">Nouveau mot de passe</h2>

                @if (_erreurs.Count > 0)
                {
                    <div class="alert alert-danger">
                        <ul class="mb-0">
                            @foreach (var erreur in _erreurs)
                            {
                                <li>@erreur</li>
                            }
                        </ul>
                    </div>
                }

                @if (_reussi)
                {
                    <div class="alert alert-success">
                        Votre mot de passe a été réinitialisé. <a href="/compte/connexion">Se connecter</a>
                    </div>
                }
                else if (!_lienValide)
                {
                    <div class="alert alert-danger">
                        Ce lien de réinitialisation est invalide ou a expiré.
                        <a href="/compte/mot-de-passe-oublie">Demander un nouveau lien</a>
                    </div>
                }
                else
                {
                    <EditForm method="post" Model="Modele" OnValidSubmit="Reinitialiser" FormName="reinitialiserMotDePasse">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label">Nouveau mot de passe</label>
                            <InputText @bind-Value="Modele!.MotDePasse" class="form-control" type="password" autocomplete="new-password" />
                            <ValidationMessage For="() => Modele!.MotDePasse" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Confirmer le mot de passe</label>
                            <InputText @bind-Value="Modele!.Confirmation" class="form-control" type="password" autocomplete="new-password" />
                            <ValidationMessage For="() => Modele!.Confirmation" />
                        </div>

                        <button type="submit" class="btn btn-success w-100">Réinitialiser</button>
                    </EditForm>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private ModeleReinitialisation? Modele { get; set; }

    [SupplyParameterFromQuery(Name = "userId")]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "jeton")]
    private string? Jeton { get; set; }

    private List<string> _erreurs = new();
    private bool _reussi;
    private bool _lienValide = true;

    protected override void OnInitialized()
    {
        Modele ??= new();
        _lienValide = !string.IsNullOrEmpty(UserId) && !string.IsNullOrEmpty(Jeton);
    }

    private async Task Reinitialiser()
    {
        _erreurs.Clear();

        if (Modele!.MotDePasse != Modele.Confirmation)
        {
            _erreurs.Add("Les mots de passe ne correspondent pas.");
            return;
        }

        var utilisateur = await UserManager.FindByIdAsync(UserId!);
        if (utilisateur is null)
        {
            _lienValide = false;
            return;
        }

        var resultat = await UserManager.ResetPasswordAsync(utilisateur, Jeton!, Modele.MotDePasse);

        if (resultat.Succeeded)
        {
            _reussi = true;
        }
        else
        {
            _erreurs = resultat.Errors.Select(e => e.Description).ToList();
        }
    }

    private class ModeleReinitialisation
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Le mot de passe est obligatoire.")]
        public string MotDePasse { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "La confirmation est obligatoire.")]
        public string Confirmation { get; set; } = string.Empty;
    }
}
