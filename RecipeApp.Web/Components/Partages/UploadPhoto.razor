@using Microsoft.AspNetCore.Components.Forms

<div>
    <InputFile OnChange="OnFichiersChoisis" accept="image/*" multiple="@Multiple" class="form-control form-control-sm" />
    @if (!string.IsNullOrEmpty(_messageErreur))
    {
        <div class="text-danger small mt-1">@_messageErreur</div>
    }
</div>

@code {
    [Parameter] public EventCallback<(string Base64, string TypeMime)> OnPhotoChoisie { get; set; }
    [Parameter] public EventCallback<List<(string Base64, string TypeMime)>> OnPhotosChoisies { get; set; }
    [Parameter] public string LibelleBtn { get; set; } = "Choisir une image";
    [Parameter] public bool Multiple { get; set; }

    private string? _messageErreur;

    // Taille max : 5 Mo par image
    private const long TailleMaxOctets = 5 * 1024 * 1024;
    private const int NombreMaxFichiers = 10;

    private async Task OnFichiersChoisis(InputFileChangeEventArgs e)
    {
        _messageErreur = null;

        var fichiers = Multiple ? e.GetMultipleFiles(NombreMaxFichiers) : new[] { e.File };
        var resultats = new List<(string Base64, string TypeMime)>();

        foreach (var fichier in fichiers)
        {
            if (fichier.Size > TailleMaxOctets)
            {
                _messageErreur = "Chaque image ne doit pas dépasser 5 Mo.";
                return;
            }

            if (!fichier.ContentType.StartsWith("image/"))
            {
                _messageErreur = "Veuillez sélectionner uniquement des fichiers image.";
                return;
            }

            try
            {
                using var flux = fichier.OpenReadStream(TailleMaxOctets);
                using var ms = new MemoryStream();
                await flux.CopyToAsync(ms);
                resultats.Add((Convert.ToBase64String(ms.ToArray()), fichier.ContentType));
            }
            catch (Exception)
            {
                _messageErreur = "Impossible de lire le fichier. Vérifiez qu'il s'agit bien d'une image.";
                return;
            }
        }

        if (resultats.Count == 0)
            return;

        if (Multiple)
            await OnPhotosChoisies.InvokeAsync(resultats);
        else
            await OnPhotoChoisie.InvokeAsync(resultats[0]);
    }
}
