# Copiez ce fichier en .env et remplissez les valeurs

# Base de données MySQL (choisissez des mots de passe forts)
DB_PASSWORD=choisir-un-mot-de-passe-fort
DB_ROOT_PASSWORD=choisir-un-mot-de-passe-root-fort

# API Gemini (obligatoire)
GEMINI_API_KEY=votre-cle-api-gemini-ici

# Mode bêta — laisser vide pour ouvrir l'inscription à tous
BETA_CODE_INVITATION=

# AWS S3 — laisser vide pour utiliser le stockage local
AWS_BUCKET_NAME=
AWS_REGION=us-east-1
# Sur EC2 avec rôle IAM : laisser vide (credentials automatiques)
# En local ou hors EC2 : renseigner les clés d'un utilisateur IAM
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Envoi de courriel (mot de passe oublié) — via l'API Resend
# EMAIL_RESEND_API_KEY : clé générée sur resend.com
# Sans domaine vérifié sur Resend, les courriels de test n'arrivent qu'à
# l'adresse du compte Resend lui-même — normal tant qu'aucun domaine n'est ajouté.
EMAIL_RESEND_API_KEY=
EMAIL_FROM_NAME=RecetteApp

# Mode relais manuel temporaire : si rempli, TOUS les courriels de
# réinitialisation sont envoyés à cette adresse (toi) plutôt qu'à
# l'utilisateur — à toi de transférer manuellement en attendant un domaine
# vérifié. Laisser vide pour un envoi direct normal à l'utilisateur.
EMAIL_ADMIN_RELAY_ADDRESS=
